          "name": "Adobe Lightroom Upload the Original Master File",
          "request": {
            "name": "Adobe Lightroom Upload the Original Master File",
            "description": {
              "content": "Uploads the original (master) image or video file for a previously created asset. The Content-Type header must match the file type being uploaded. Supported formats include JPEG, PNG, TIFF, DNG, and MP4.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalogs",
                ":catalog_id",
                "assets",
                ":asset_id",
                "master"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "catalog_id",
                  "description": "(Required) Unique identifier of the Lightroom catalog"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "asset_id",
                  "description": "(Required) Unique identifier of the asset (UUID format)"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) API key from Adobe Developer Console",
                "key": "X-Api-Key",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "Content-Length",
                "value": "<integer>"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<binary>"
            }
