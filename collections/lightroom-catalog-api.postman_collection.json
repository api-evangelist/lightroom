  "info": {
    "_postman_id": "a3543304-a7ed-4d5a-a274-601de29a958d",
    "name": "Adobe Lightroom Lightroom Albums Album Assets Catalog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "API for creating and managing albums and collections within an Adobe Lightroom cloud catalog. Albums organize assets into user-defined collections. Supports listing, creating, updating, and deleting albums as well as managing the assets within each album.\n\nContact Support:\n Name: Adobe Lightroom Developer Support",
      "type": "text/plain"
    }
  }
