  "info": {
    "_postman_id": "bb705bc1-79b7-4c07-9814-aa8543511154",
    "name": "Adobe Lightroom Lightroom Catalog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "API for accessing catalog information and health status for Adobe Lightroom cloud services. Each Lightroom customer has a single catalog that serves as the top-level container for all their assets, albums, and metadata. The catalog ID is required for most other Lightroom API operations.\n\nContact Support:\n Name: Adobe Lightroom Developer Support",
      "type": "text/plain"
    }
