          "name": "Adobe Lightroom Get an Asset Rendition",
          "request": {
            "name": "Adobe Lightroom Get an Asset Rendition",
            "description": {
              "content": "Retrieves a server-generated rendition of the asset at the specified size. Renditions are JPEG preview images generated from the master file with current develop settings applied.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalogs",
                ":catalog_id",
                "assets",
                ":asset_id",
                "renditions",
                ":rendition_type"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "catalog_id",
                  "description": "(Required) Unique identifier of the Lightroom catalog"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "asset_id",
                  "description": "(Required) Unique identifier of the asset (UUID format)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "rendition_type",
                  "description": "(Required) Rendition size type. thumbnail2x is a small thumbnail, numeric values indicate the longest edge in pixels, and fullsize is the maximum resolution available."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) API key from Adobe Developer Console",
                "key": "X-Api-Key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "image/jpeg"
              }
            ],
            "method": "GET",
