                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/lrService/autoStraighten",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "lrService",
                    "autoStraighten"
                  ]
                },
                "description": "Detects the horizon or dominant lines in an image and applies a rotation correction to straighten it. Uses AI analysis to determine the appropriate rotation angle, similar to Lightroom's auto straighten feature in the Crop & Rotate tool."
