  "info": {
    "_postman_id": "240a613b-79dd-462c-82c0-3ec1e11083d3",
    "name": "Adobe Lightroom Lightroom Albums Album Assets Master API",
    "description": "API for creating and managing albums and collections within an Adobe Lightroom cloud catalog. Albums organize assets into user-defined collections. Supports listing, creating, updating, and deleting albums as well as managing the assets within each album.\n\nContact Support:\n Name: Adobe Lightroom Developer Support",
