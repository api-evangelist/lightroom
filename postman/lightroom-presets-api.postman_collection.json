      "item": [
        {
          "name": "presets",
          "item": [
            {
              "name": "Adobe Lightroom Apply Lightroom Presets to an Image",
              "id": "243adc3e-40da-4578-b2ea-a7887708e2c1",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "description": "(Required) API key (client_id) from Adobe Developer Console",
                    "key": "X-Api-Key",
                    "value": "<string>"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"inputs\": {\n    \"source\": {\n      \"href\": \"<string>\",\n      \"storage\": \"azure\"\n    },\n    \"presets\": [\n      {\n        \"href\": \"<string>\",\n        \"storage\": \"azure\"\n      },\n      {\n        \"href\": \"<string>\",\n        \"storage\": \"external\"\n      }\n    ]\n  },\n  \"outputs\": [\n    {\n      \"href\": \"<string>\",\n      \"storage\": \"adobe\",\n      \"type\": \"image/dng\",\n      \"overwrite\": true,\n      \"quality\": \"<integer>\"\n    },\n    {\n      \"href\": \"<string>\",\n      \"storage\": \"azure\",\n      \"type\": \"image/tiff\",\n      \"overwrite\": true,\n      \"quality\": \"<integer>\"\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/lrService/presets",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "lrService",
                    "presets"
                  ]
                },
                "description": "Applies one or more Lightroom presets (XMP develop settings files) to an image. Presets are provided as references to XMP files stored in cloud storage. Multiple presets can be applied in sequence, with later presets overriding earlier settings where they overlap."
              },
